{
  "name": "any-llm-ts",
  "version": "0.5.1",
  "description": "A unified TypeScript interface for multiple LLM providers",
  "keywords": [
    "ai",
    "anthropic",
    "gemini",
    "google",
    "llm",
    "openai",
    "typescript"
  ],
  "homepage": "https://github.com/anurag-roy/any-llm-ts#readme",
  "bugs": {
    "url": "https://github.com/anurag-roy/any-llm-ts/issues"
  },
  "license": "Apache-2.0",
  "author": "Anurag Roy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anurag-roy/any-llm-ts.git"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:check": "npm run build && npm --prefix apps/docs run generate:providers -- --check && npm --prefix apps/docs run format:check && npm --prefix apps/docs run lint && npm --prefix apps/docs run types:check && npm run docs:build && npm --prefix apps/docs run check:links",
    "docs:dev": "npm --prefix apps/docs run dev",
    "docs:generate": "npm run build && npm --prefix apps/docs run generate:providers",
    "format": "oxfmt --disable-nested-config .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "lint": "oxlint .",
    "parity:check": "vitest run tests/parity.test.ts",
    "release": "npm run check && changeset publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version && npm run docs:generate"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^0.4.1",
    "@anthropic-ai/sdk": "^0.115.0",
    "@anthropic-ai/vertex-sdk": "^0.19.1",
    "@aws-sdk/client-bedrock": "^3.1107.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1107.0",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1107.0",
    "@azure-rest/ai-inference": "^1.0.0-beta.6",
    "@azure/core-auth": "^1.11.0",
    "@google/genai": "^2.16.0",
    "@huggingface/inference": "^4.13.25",
    "@ibm-cloud/watsonx-ai": "^1.7.16",
    "@mistralai/mistralai": "^2.6.1",
    "openai": "^7.4.0",
    "voyageai": "^0.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
