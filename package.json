{
  "name": "any-llm-ts",
  "version": "0.1.0",
  "description": "A unified TypeScript interface for multiple LLM providers",
  "keywords": [
    "ai",
    "anthropic",
    "gemini",
    "google",
    "llm",
    "openai",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Anurag Roy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anurag-roy/any-llm-ts.git"
  },
  "bugs": {
    "url": "https://github.com/anurag-roy/any-llm-ts/issues"
  },
  "homepage": "https://github.com/anurag-roy/any-llm-ts#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:check": "npm run build && npm --prefix apps/docs run generate:providers -- --check && npm --prefix apps/docs run lint && npm --prefix apps/docs run types:check && npm run docs:build && npm --prefix apps/docs run check:links",
    "docs:dev": "npm --prefix apps/docs run dev",
    "docs:generate": "npm run build && npm --prefix apps/docs run generate:providers",
    "lint": "eslint .",
    "release": "npm run check && changeset publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.16.0",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
